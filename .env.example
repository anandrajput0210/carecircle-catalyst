# CareCircle Environment Configuration Template

# Server & Security
ENVIRONMENT=development
PORT=8000
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-in-production
COOKIE_SECURE=False

# Firebase Firestore (Server-Side Service Account)
# Spark Plan - No billing required. Do NOT expose this to frontend client code.
FIREBASE_PROJECT_ID=carecircle-catalyst
FIREBASE_SERVICE_ACCOUNT_KEY_B64=

# Google Gemini API (Google AI Studio Free Tier)
GEMINI_API_KEY=

# Internal Cron / Escalation Trigger Secret (Protects /api/cron/* endpoints)
CRON_SECRET=carecircle-local-cron-secret-key

# Optional Real Email Delivery (e.g. Resend Free Tier)
# If left empty, CareCircle strictly records "IN_APP_ONLY" and will NEVER fake delivery.
RESEND_API_KEY=
SENDER_EMAIL=
